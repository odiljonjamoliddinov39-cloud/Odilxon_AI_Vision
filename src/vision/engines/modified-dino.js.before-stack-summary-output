import { performance } from "node:perf_hooks";
import path from "node:path";
import { fileURLToPath } from "node:url";
import sharp from "sharp";
import { clamp, iou } from "../geometry.js";

const DEFAULT_MODEL_DIR = fileURLToPath(
  new URL("../../../models/grounding-dino-tiny-ONNX", import.meta.url),
);

let pipelinePromise;

async function loadPipeline(modelDirectory) {
  pipelinePromise ||= (async () => {
    const { env, pipeline, RawImage } = await import("@huggingface/transformers");
    env.allowRemoteModels = false;
    env.allowLocalModels = true;
    env.localModelPath = `${path.dirname(modelDirectory)}${path.sep}`;
    const detector = await pipeline(
      "zero-shot-object-detection",
      path.basename(modelDirectory),
      { dtype: "q8", device: "cpu" },
    );
    return { detector, RawImage };
  })();
  return pipelinePromise;
}

function nms(items, threshold = 0.45) {
  const sorted = [...items].sort((a, b) => b.confidence - a.confidence);
  const kept = [];
  for (const c of sorted) {
    if (kept.every((x) => iou(c.bbox, x.bbox) < threshold)) kept.push(c);
  }
  return kept;
}

async function detectDino(buffer, width, height, target, threshold, modelDirectory) {
  const { detector, RawImage } = await loadPipeline(modelDirectory);
  const pixels = await sharp(buffer).toColourspace("srgb").removeAlpha().raw().toBuffer();
  const image = new RawImage(new Uint8Array(pixels), width, height, 3);
  const prompt = `${target.toLowerCase().replace(/[.\s]+$/u, "")}.`;
  const output = await detector(image, [prompt], { threshold });

  return output.map((item, index) => {
    const b = item.box || {};
    const x1 = clamp(Number(b.xmin), 0, width);
    const y1 = clamp(Number(b.ymin), 0, height);
    const x2 = clamp(Number(b.xmax), 0, width);
    const y2 = clamp(Number(b.ymax), 0, height);
    return {
      id: `dino_${index}`,
      label: target,
      confidence: Number(item.score),
      bbox: {
        x: Math.round(x1), y: Math.round(y1),
        width: Math.round(x2 - x1), height: Math.round(y2 - y1),
      },
    };
  }).filter(x => x.bbox.width > 8 && x.bbox.height > 8);
}

/*
  Replacement formula:
  DINO only supplies the stack ROI.
  This function does NOT ask DINO to count the stack again.

  It looks for persistent horizontal carton seams inside the ROI:
  - grayscale image
  - vertical intensity derivative for every row
  - robust row score across the middle 80% of the stack
  - adaptive threshold from median/MAD
  - merge neighboring edge rows
  - infer carton pitch from repeated seam spacing
  - convert the ROI into one physical-item band per inferred layer

  It intentionally refuses to invent layers if the seam signal is weak.
*/
async function decomposeStack(fullBuffer, root, imageSize, target) {
  const padX = Math.round(root.bbox.width * 0.02);
  const padY = Math.round(root.bbox.height * 0.02);
  const left = Math.max(0, root.bbox.x - padX);
  const top = Math.max(0, root.bbox.y - padY);
  const width = Math.min(imageSize.width - left, root.bbox.width + padX * 2);
  const height = Math.min(imageSize.height - top, root.bbox.height + padY * 2);

  if (width < 120 || height < 90) {
    return { instances: [root], debug: { decision: "too_small" } };
  }

  const { data, info } = await sharp(fullBuffer)
    .extract({ left, top, width, height })
    .greyscale()
    .raw()
    .toBuffer({ resolveWithObject: true });

  const W = info.width;
  const H = info.height;

  const mean = (a) => a.length ? a.reduce((s,v)=>s+v,0)/a.length : 0;
  const median = (a) => {
    if (!a.length) return 0;
    const b=[...a].sort((x,y)=>x-y);
    return b[Math.floor(b.length/2)];
  };
  const percentile = (a,p) => {
    if (!a.length) return 0;
    const b=[...a].sort((x,y)=>x-y);
    return b[Math.min(b.length-1,Math.floor(b.length*p))];
  };
  const smooth = (a,r) => a.map((_,i)=>{
    let s=0,n=0;
    for(let j=Math.max(0,i-r);j<=Math.min(a.length-1,i+r);j++){s+=a[j];n++;}
    return n?s/n:0;
  });

  // Edge projections:
  // rowEdge[y] = strength of a horizontal boundary
  // colEdge[x] = strength of a vertical boundary
  const rowEdgeRaw = new Array(H).fill(0);
  const colEdgeRaw = new Array(W).fill(0);

  for (let y=2;y<H-2;y++) {
    const vals=[];
    for (let x=Math.round(W*0.05);x<Math.round(W*0.95);x+=3) {
      vals.push(Math.abs(data[(y+2)*W+x]-data[(y-2)*W+x]));
    }
    rowEdgeRaw[y]=percentile(vals,0.72);
  }

  for (let x=2;x<W-2;x++) {
    const vals=[];
    for (let y=Math.round(H*0.05);y<Math.round(H*0.95);y+=3) {
      vals.push(Math.abs(data[y*W+(x+2)]-data[y*W+(x-2)]));
    }
    colEdgeRaw[x]=percentile(vals,0.72);
  }

  const rowEdge=smooth(rowEdgeRaw,Math.max(2,Math.round(H*0.006)));
  const colEdge=smooth(colEdgeRaw,Math.max(2,Math.round(W*0.006)));

  function normalizeSignal(sig) {
    const m=median(sig);
    const mad=median(sig.map(v=>Math.abs(v-m))) || 1;
    return sig.map(v=>Math.max(0,(v-m)/(mad*3.0)));
  }

  const rowN=normalizeSignal(rowEdge);
  const colN=normalizeSignal(colEdge);

  // Find a repeated pitch even when some boundaries are hidden.
  // This is the key change: missing edges do not remove the box;
  // visible repeated edges establish a lattice and the lattice predicts them.
  function estimatePitch(signal,minPitch,maxPitch) {
    const N=signal.length;
    minPitch=Math.max(8,Math.round(minPitch));
    maxPitch=Math.min(N-2,Math.round(maxPitch));
    let best={pitch:0,score:0};

    const energy=signal.reduce((s,v)=>s+v*v,0)+1e-9;

    for(let p=minPitch;p<=maxPitch;p++) {
      let num=0,den=0;
      for(let i=0;i<N-p;i++) {
        num += signal[i]*signal[i+p];
        den += signal[i]*signal[i] + signal[i+p]*signal[i+p];
      }
      const score=(2*num)/(den+1e-9);
      if(score>best.score) best={pitch:p,score};
    }
    return best;
  }

  // Carton rows: roughly 3-12 possible layers inside a DINO stack.
  const rowPitch=estimatePitch(rowN,H*0.07,H*0.34);

  if (rowPitch.pitch <= 0 || rowPitch.score < 0.10) {
    return {
      instances:[root],
      debug:{decision:"no_row_lattice",rowPitch}
    };
  }

  // Find lattice phase: offset whose repeated predicted lines receive the most edge support.
  function bestPhase(signal,pitch) {
    let best={phase:0,score:-Infinity};
    for(let phase=0;phase<pitch;phase++) {
      let s=0,n=0;
      for(let pos=phase;pos<signal.length;pos+=pitch) {
        let local=0;
        for(let d=-3;d<=3;d++) {
          const i=pos+d;
          if(i>=0 && i<signal.length) local=Math.max(local,signal[i]);
        }
        s+=local;n++;
      }
      const score=n?s/n:0;
      if(score>best.score) best={phase,score};
    }
    return best;
  }

  const rowPhase=bestPhase(rowN,rowPitch.pitch);

  // Create predicted horizontal lattice lines across the ROI.
  const rowLines=[];
  for(let y=rowPhase.phase;y<H;y+=rowPitch.pitch) rowLines.push(y);
  for(let y=rowPhase.phase-rowPitch.pitch;y>=0;y-=rowPitch.pitch) rowLines.unshift(y);

  // Extend to ROI edges only when they are close to one pitch.
  if(!rowLines.length || rowLines[0] > rowPitch.pitch*0.65) rowLines.unshift(0);
  else rowLines[0]=0;
  if(H-rowLines[rowLines.length-1] > rowPitch.pitch*0.65) rowLines.push(H);
  else rowLines[rowLines.length-1]=H;

  const instances=[];
  const rowsDebug=[];

  function localVerticalProjection(yA,yB) {
    const signal=new Array(W).fill(0);
    const yy0=Math.max(yA+2,Math.round(yA+(yB-yA)*0.15));
    const yy1=Math.min(yB-2,Math.round(yB-(yB-yA)*0.15));

    for(let x=2;x<W-2;x++) {
      const vals=[];
      for(let y=yy0;y<yy1;y+=2) {
        vals.push(Math.abs(data[y*W+(x+2)]-data[y*W+(x-2)]));
      }
      signal[x]=percentile(vals,0.72);
    }
    return normalizeSignal(smooth(signal,Math.max(2,Math.round(W*0.005))));
  }

  function cellVariance(xA,yA,xB,yB) {
    const vals=[];
    const sx=Math.max(1,Math.floor((xB-xA)/18));
    const sy=Math.max(1,Math.floor((yB-yA)/10));
    for(let y=yA;y<yB;y+=sy) {
      for(let x=xA;x<xB;x+=sx) vals.push(data[y*W+x]);
    }
    const m=mean(vals);
    return mean(vals.map(v=>(v-m)*(v-m)));
  }

  function lineSupport(signal,pos) {
    let s=0;
    for(let d=-4;d<=4;d++) {
      const i=Math.round(pos+d);
      if(i>=0 && i<signal.length) s=Math.max(s,signal[i]);
    }
    return s;
  }

  for(let r=0;r<rowLines.length-1;r++) {
    const yA=Math.max(0,Math.round(rowLines[r]));
    const yB=Math.min(H,Math.round(rowLines[r+1]));
    const bandH=yB-yA;

    // Ignore fragments created only by ROI clipping.
    if(bandH < rowPitch.pitch*0.48) continue;

    const vSignal=localVerticalProjection(yA,yB);

    // Search for repeated columns. Allow 1-5 cartons across a row.
    const colPitch=estimatePitch(vSignal,W*0.16,W*0.62);

    let colLines=[0,W];
    let colPhase={phase:0,score:0};
    let useColumnLattice=false;

    if(colPitch.pitch>0 && colPitch.score>=0.10) {
      colPhase=bestPhase(vSignal,colPitch.pitch);

      const predicted=[];
      for(let x=colPhase.phase;x<W;x+=colPitch.pitch) predicted.push(x);
      for(let x=colPhase.phase-colPitch.pitch;x>=0;x-=colPitch.pitch) predicted.unshift(x);

      // Only accept a multi-column lattice when at least two predicted internal
      // boundaries have some visible support. Missing individual boundaries are okay.
      const internal=predicted.filter(x=>x>W*0.08 && x<W*0.92);
      const supported=internal.filter(x=>lineSupport(vSignal,x)>=0.35);

      if(internal.length>=1 && supported.length>=Math.min(2,internal.length)) {
        colLines=[0,...internal,W].sort((a,b)=>a-b);
        useColumnLattice=true;
      }
    }

    const cells=[];
    for(let c=0;c<colLines.length-1;c++) {
      const xA=Math.max(0,Math.round(colLines[c]));
      const xB=Math.min(W,Math.round(colLines[c+1]));
      const cellW=xB-xA;

      if(cellW < W*0.10) continue;

      const leftSupport = c===0 ? 0.7 : lineSupport(vSignal,xA);
      const rightSupport = c===colLines.length-2 ? 0.7 : lineSupport(vSignal,xB);
      const topSupport = r===0 ? 0.7 : lineSupport(rowN,yA);
      const bottomSupport = r===rowLines.length-2 ? 0.7 : lineSupport(rowN,yB);

      // Occlusion completion:
      // A cell may survive with one or two missing sides if the lattice itself is strong
      // and the cell contains real image texture.
      const borderSupport=(leftSupport+rightSupport+topSupport+bottomSupport)/4;
      const variance=cellVariance(xA,yA,xB,yB);
      const latticeConfidence=(rowPitch.score + (useColumnLattice?colPitch.score:0.12))/2;

      const accepted =
        variance > 18 &&
        (
          borderSupport >= 0.20 ||
          latticeConfidence >= 0.24
        );

      if(!accepted) continue;

      cells.push({
        id:`${root.id}_r${r+1}_c${c+1}`,
        label:target,
        confidence:Math.min(
          root.confidence,
          root.confidence*(0.65+Math.min(0.35,latticeConfidence))
        ),
        bbox:{
          x:left+xA,
          y:top+yA,
          width:Math.max(2,cellW),
          height:Math.max(2,bandH),
        },
      });
    }

    // If a row is clearly present but no reliable column repetition exists,
    // preserve it as one physical carton candidate rather than inventing columns.
    if(!cells.length && bandH>=rowPitch.pitch*0.65) {
      const variance=cellVariance(0,yA,W,yB);
      if(variance>18) {
        cells.push({
          id:`${root.id}_r${r+1}_c1`,
          label:target,
          confidence:root.confidence*0.75,
          bbox:{x:left,y:top+yA,width:W,height:bandH},
        });
      }
    }

    instances.push(...cells);
    rowsDebug.push({
      row:r+1,
      y:[yA,yB],
      rowHeight:bandH,
      columnLattice:useColumnLattice,
      colPitch,
      colPhase,
      columns:colLines,
      acceptedCells:cells.length,
    });
  }

  // Safety: only replace DINO's stack if the lattice produces a believable
  // multi-instance decomposition.
  if(instances.length<2) {
    return {
      instances:[root],
      debug:{
        decision:"keep_parent",
        rowPitch,
        rowPhase,
        rowLines,
        rows:rowsDebug,
      },
    };
  }

  return {
    instances,
    debug:{
      decision:"lattice_decomposed",
      rowPitch,
      rowPhase,
      rowLines,
      rows:rowsDebug,
      cells:instances.length,
    },
  };
}
export class ModifiedDinoEngine {
  constructor(config = {}) {
    this.name = "modified_dino";
    this.modelDirectory = config.modelDirectory || DEFAULT_MODEL_DIR;
    this.threshold = Number.isFinite(Number(config.threshold)) ? Number(config.threshold) : 0.25;
    this.nmsIou = Number.isFinite(Number(config.nmsIou)) ? Number(config.nmsIou) : 0.42;
  }

  info() {
    return {
      name: this.name,
      family: "Grounding DINO + carton seam decomposer",
      mode: "stack_roi_to_physical_layers",
      threshold: this.threshold,
    };
  }

  async analyze({ frame, instruction = {}, debug = false } = {}) {
    const imagePath = typeof frame === "string" ? frame : frame?.filePath;
    if (!imagePath) throw Object.assign(new Error("Persisted frame required."), { status: 400 });

    const target = String(instruction.target || "").trim();
    if (!target) throw Object.assign(new Error("instruction.target required."), { status: 400 });

    const threshold = Number.isFinite(Number(instruction.threshold))
      ? clamp(Number(instruction.threshold), 0, 1)
      : this.threshold;

    const fullBuffer = await sharp(imagePath).jpeg({ quality: 95 }).toBuffer();
    const meta = await sharp(fullBuffer).metadata();
    const imageSize = { width: meta.width, height: meta.height };

    const started = performance.now();
    const roots = nms(
      await detectDino(fullBuffer, imageSize.width, imageSize.height, target, threshold, this.modelDirectory),
      this.nmsIou
    );

    const all = [];
    const trace = [];
    for (const root of roots) {
      const result = await decomposeStack(fullBuffer, root, imageSize, target);
      all.push(...result.instances);
      trace.push({ root: root.bbox, ...result.debug });
    }

    // Do not NMS the layer bands against each other: adjacent physical layers are expected.
    const objects = all.map((o, i) => ({ ...o, id: `instance_${i+1}` }));
    const inferenceMs = Math.round(performance.now() - started);

    return {
      engine: this.name,
      objects,
      count: objects.length,
      confidence: objects.length
        ? objects.reduce((s,x)=>s+x.confidence,0)/objects.length
        : null,
      evidence: [
        { type: "dino_stack_roots", value: roots.length },
        { type: "decomposed_instances", value: objects.length },
      ],
      inferenceMs,
      debug: debug ? { decompositionTrace: trace } : undefined,
    };
  }
}

