import { performance } from "node:perf_hooks";
import path from "node:path";
import { fileURLToPath } from "node:url";
import sharp from "sharp";
import { clamp, iou } from "../geometry.js";

const DEFAULT_MODEL_DIR = fileURLToPath(
  new URL("../../../models/grounding-dino-tiny-ONNX", import.meta.url),
);

let pipelinePromise;

async function loadPipeline(modelDirectory) {
  pipelinePromise ||= (async () => {
    const { env, pipeline, RawImage } = await import("@huggingface/transformers");
    env.allowRemoteModels = false;
    env.allowLocalModels = true;
    env.localModelPath = `${path.dirname(modelDirectory)}${path.sep}`;
    const detector = await pipeline(
      "zero-shot-object-detection",
      path.basename(modelDirectory),
      { dtype: "q8", device: "cpu" },
    );
    return { detector, RawImage };
  })();
  return pipelinePromise;
}

function nms(items, threshold = 0.45) {
  const sorted = [...items].sort((a, b) => b.confidence - a.confidence);
  const kept = [];
  for (const candidate of sorted) {
    if (kept.every((x) => iou(candidate.bbox, x.bbox) < threshold)) {
      kept.push(candidate);
    }
  }
  return kept;
}

function almostSameBox(a, b) {
  const overlap = iou(a, b);
  const areaA = a.width * a.height;
  const areaB = b.width * b.height;
  const ratio = Math.min(areaA, areaB) / Math.max(areaA, areaB, 1);
  return overlap > 0.82 && ratio > 0.72;
}

function mapChildToImage(child, crop) {
  return {
    ...child,
    bbox: {
      x: crop.x + child.bbox.x,
      y: crop.y + child.bbox.y,
      width: child.bbox.width,
      height: child.bbox.height,
    },
  };
}

export class ModifiedDinoEngine {
  constructor(config = {}) {
    this.name = "modified_dino";
    this.modelDirectory = config.modelDirectory || DEFAULT_MODEL_DIR;
    this.threshold = Number.isFinite(Number(config.threshold)) ? Number(config.threshold) : 0.25;
    this.childThreshold = Number.isFinite(Number(config.childThreshold))
      ? Number(config.childThreshold)
      : Math.max(0.08, this.threshold * 0.55);
    this.maxDepth = Number.isInteger(config.maxDepth) ? config.maxDepth : 2;
    this.nmsIou = Number.isFinite(Number(config.nmsIou)) ? Number(config.nmsIou) : 0.42;
    this.margin = Number.isFinite(Number(config.margin)) ? Number(config.margin) : 0.04;
    this.minCropPixels = Number.isFinite(Number(config.minCropPixels))
      ? Number(config.minCropPixels)
      : 80;
  }

  info() {
    return {
      name: this.name,
      family: "Grounding DINO",
      mode: "recursive_instance_decomposition",
      strategy:
        "Use stock DINO to locate regions, then recursively re-run the same DINO inside each region and replace a parent only when multiple defensible child instances appear.",
      threshold: this.threshold,
      childThreshold: this.childThreshold,
      maxDepth: this.maxDepth,
      nmsIou: this.nmsIou,
    };
  }

  async detectImage(buffer, width, height, target, threshold) {
    const { detector, RawImage } = await loadPipeline(this.modelDirectory);
    const pixels = await sharp(buffer).toColourspace("srgb").removeAlpha().raw().toBuffer();
    const image = new RawImage(new Uint8Array(pixels), width, height, 3);
    const prompt = `${target.toLowerCase().replace(/[.\s]+$/u, "")}.`;
    const output = await detector(image, [prompt], { threshold });

    return output
      .map((item, index) => {
        const box = item.box || {};
        const xmin = clamp(Number(box.xmin), 0, width);
        const ymin = clamp(Number(box.ymin), 0, height);
        const xmax = clamp(Number(box.xmax), 0, width);
        const ymax = clamp(Number(box.ymax), 0, height);
        return {
          id: `q${index}`,
          label: target,
          confidence: Number(item.score),
          bbox: {
            x: Math.round(xmin),
            y: Math.round(ymin),
            width: Math.round(xmax - xmin),
            height: Math.round(ymax - ymin),
          },
        };
      })
      .filter((x) => x.bbox.width > 2 && x.bbox.height > 2);
  }

  async splitRegion(fullImageBuffer, imageSize, parent, target, depth, trace) {
    if (depth >= this.maxDepth) return [parent];

    const marginX = Math.round(parent.bbox.width * this.margin);
    const marginY = Math.round(parent.bbox.height * this.margin);
    const crop = {
      x: clamp(parent.bbox.x - marginX, 0, imageSize.width - 1),
      y: clamp(parent.bbox.y - marginY, 0, imageSize.height - 1),
      width: 0,
      height: 0,
    };
    crop.width = Math.min(
      imageSize.width - crop.x,
      parent.bbox.width + marginX * 2,
    );
    crop.height = Math.min(
      imageSize.height - crop.y,
      parent.bbox.height + marginY * 2,
    );

    if (crop.width < this.minCropPixels || crop.height < this.minCropPixels) {
      return [parent];
    }

    const cropBuffer = await sharp(fullImageBuffer)
      .extract({
        left: Math.round(crop.x),
        top: Math.round(crop.y),
        width: Math.max(1, Math.round(crop.width)),
        height: Math.max(1, Math.round(crop.height)),
      })
      .jpeg({ quality: 95 })
      .toBuffer();

    const localChildren = await this.detectImage(
      cropBuffer,
      Math.round(crop.width),
      Math.round(crop.height),
      target,
      this.childThreshold,
    );

    let children = nms(
      localChildren.map((c) => mapChildToImage(c, crop)),
      this.nmsIou,
    );

    // Remove DINO's common "same parent again" response.
    children = children.filter((c) => !almostSameBox(c.bbox, parent.bbox));

    // A parent is replaced only by an actual split into >= 2 non-duplicate children.
    if (children.length < 2) {
      trace.push({
        depth,
        parent: parent.bbox,
        decision: "keep_parent",
        childCandidates: children.length,
      });
      return [parent];
    }

    trace.push({
      depth,
      parent: parent.bbox,
      decision: "split",
      childCandidates: children.length,
    });

    const leaves = [];
    for (const child of children) {
      leaves.push(
        ...(await this.splitRegion(
          fullImageBuffer,
          imageSize,
          child,
          target,
          depth + 1,
          trace,
        )),
      );
    }
    return leaves;
  }

  async analyze({ frame, instruction = {}, debug = false } = {}) {
    const imagePath = typeof frame === "string" ? frame : frame?.filePath;
    if (!imagePath) {
      throw Object.assign(new Error("Vision engine requires a persisted frame."), {
        status: 400,
      });
    }

    const target = String(instruction.target || "").trim();
    if (!target) {
      throw Object.assign(new Error("Modified DINO requires instruction.target."), {
        status: 400,
      });
    }

    const threshold = Number.isFinite(Number(instruction.threshold))
      ? clamp(Number(instruction.threshold), 0, 1)
      : this.threshold;

    const fullImageBuffer = await sharp(imagePath).jpeg({ quality: 95 }).toBuffer();
    const meta = await sharp(fullImageBuffer).metadata();
    const imageSize = { width: meta.width, height: meta.height };
    if (!imageSize.width || !imageSize.height) {
      throw new Error("Unable to read frame dimensions.");
    }

    const started = performance.now();
    const roots = nms(
      await this.detectImage(
        fullImageBuffer,
        imageSize.width,
        imageSize.height,
        target,
        threshold,
      ),
      this.nmsIou,
    );

    const trace = [];
    const leaves = [];
    for (const root of roots) {
      leaves.push(
        ...(await this.splitRegion(
          fullImageBuffer,
          imageSize,
          root,
          target,
          0,
          trace,
        )),
      );
    }

    const objects = nms(leaves, this.nmsIou).map((o, index) => ({
      ...o,
      id: `instance_${index + 1}`,
    }));

    const inferenceMs = Math.round(performance.now() - started);

    return {
      engine: this.name,
      objects,
      count: objects.length,
      confidence: objects.length
        ? objects.reduce((s, x) => s + x.confidence, 0) / objects.length
        : null,
      evidence: [
        { type: "root_detections", value: roots.length },
        { type: "leaf_instances", value: objects.length },
      ],
      inferenceMs,
      debug: debug
        ? {
            roots: roots.map((x) => x.bbox),
            decompositionTrace: trace,
            maxDepth: this.maxDepth,
            threshold,
            childThreshold: this.childThreshold,
          }
        : undefined,
    };
  }
}
